# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Required for Supabase Auth, Postgres DB & Storage)
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server — never prefix with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL ADMIN ACCESS OVERRIDES (Server-side only)
# Optional single owner email allowlist when using Supabase Auth:
ADMIN_EMAIL=
# Optional shared admin passcode override for local/non-Supabase environments:
ADMIN_PASSCODE=

# EMAIL NOTIFICATIONS (Resend — Server-side only; never prefix with VITE_)
RESEND_API_KEY=
EMAIL_FROM=

# GOOGLE DRIVE SERVER OAUTH OVERRIDE (Optional — AI Studio Firebase OAuth is already configured in firebase-applet-config.json)
# Only needed if deploying standalone outside AI Studio with server-side offline refresh tokens:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OBJECT STORAGE FOR PUBLISHED MEDIA (Cloudflare R2 — Server-side only; falls back to Supabase Storage CDN if omitted)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=


